generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────
// 환자 운영 데이터 (PII 분리 원칙)
// Patient: 운영에 필요한 최소 필드만 보유
// PatientIdentity: 직접 식별 가능 정보 (이름, 연락처)
// ──────────────────────────────────────────────

model Patient {
  id          String   @id @default(cuid())
  tenantId    String?  // 멀티테넌시: null = 레거시 (마이그레이션 전)
  chartNumber String   @unique
  gender      String   // M/F - 운영/리콜 판단에 필요
  birthYear   Int      // 연령대 계산용 - 운영에 필요
  isVip       Boolean  @default(false)
  tags        String?  // 운영 태그 (자유 텍스트 메모 아님, 정형화된 태그만)
  // 수신 거부 / 연락 금지
  doNotContact       Boolean   @default(false)
  doNotContactAt     DateTime?
  doNotContactReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant                Tenant?              @relation(fields: [tenantId], references: [id])
  identity              PatientIdentity?
  visits                Visit[]
  recallRecommendations RecallRecommendation[]
  messageDrafts         MessageDraft[]
  outboundMessages      OutboundMessage[]
  workflowTasks         WorkflowTask[]
  activityLogs          ActivityLog[]

  @@index([tenantId])
}

// PII 계층: 직접 식별정보 분리 저장
// 운영 목적에서는 Patient.id로만 참조하고,
// 이름/연락처는 권한 있는 사용자만 접근
model PatientIdentity {
  id        String   @id @default(cuid())
  patientId String   @unique
  name      String   // PII: 마스킹 처리 대상
  phone     String   // PII: 마스킹 처리 대상
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// 방문 이력 + 유입 경로 추적
// ──────────────────────────────────────────────

model Visit {
  id         String   @id @default(cuid())
  patientId  String
  visitDate  DateTime
  memo       String?  // 운영 메모 (차트 원문 아님)
  // 유입 경로 추적 필드
  sourceRaw  String?  // EMR 원문 유입 경로 텍스트 (정제 전)
  channel    String?  // 표준화 채널: walk_in, referral, cta_naver, cta_google, cta_kakao, online, phone
  isCta      Boolean  @default(false) // CTA 광고 기여 방문 여부
  campaignId String?  // CTA 캠페인 연결
  // 방문경로 정규화 필드 (시스템 추천 vs 사람 확정 분리)
  normalizedSource  String?  // 시스템 추천 정규화 소스 (예: "Instagram", "Naver Search Ads")
  sourceCategory    String?  // 시스템 추천 카테고리 (예: "SNS", "Search Ads", "Referral")
  ctaCandidate      Boolean? // 시스템 추천 CTA 후보 여부
  matchConfidence   String?  // 매칭 신뢰도: HIGH, MEDIUM, LOW
  matchReason       String?  // 매칭 근거 텍스트
  matchedRuleId     String?  // 매칭된 SourceRule ID
  // 사람이 최종 확정한 값
  reviewedSource    String?  // 최종 확정 정규화 소스
  reviewedCategory  String?  // 최종 확정 카테고리
  reviewedCtaFlag   Boolean? // 최종 확정 CTA 여부
  sourceReviewStatus String  @default("unreviewed") // unreviewed, auto_confirmed, manually_confirmed, rejected
  sourceReviewedBy  String?  // 검토자
  sourceReviewedAt  DateTime? // 검토 일시
  sourceReviewMemo  String?  // 검토 메모
  createdAt  DateTime @default(now())

  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  diagnoses       Diagnosis[]
  procedures      Procedure[]
  campaign        Campaign?        @relation(fields: [campaignId], references: [id])
  leadAttribution LeadAttribution?
  matchedRule     SourceRule?      @relation(fields: [matchedRuleId], references: [id])

  @@index([patientId])
  @@index([visitDate])
  @@index([channel])
  @@index([isCta])
  @@index([sourceReviewStatus])
  @@index([matchConfidence])
}

model Diagnosis {
  id      String  @id @default(cuid())
  visitId String
  code    String
  name    String
  tooth   String?

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([code])
}

model Procedure {
  id      String  @id @default(cuid())
  visitId String
  code    String
  name    String
  tooth   String?

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([code])
}

// ──────────────────────────────────────────────
// 리콜 추천 + 메시지
// ──────────────────────────────────────────────

model RecallRecommendation {
  id             String    @id @default(cuid())
  patientId      String
  ruleType       String
  subType        String
  priority       Int       @default(3)
  status         String    @default("pending")
  reason         String
  evidenceDate   DateTime?
  evidenceDetail String?
  dueDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([ruleType])
  @@index([status])
  @@index([priority])
}

model MessageDraft {
  id        String   @id @default(cuid())
  patientId String
  recallId  String?
  tone      String   @default("polite")
  length    String   @default("medium")
  content   String
  status    String   @default("draft") // draft, reviewed, queued, sent, failed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient    Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  deliveries MessageDelivery[]

  @@index([patientId])
  @@index([status])
}

// ──────────────────────────────────────────────
// 메시지 발송 (카카오톡 채널 등)
// 실제 발송 provider와 상태를 추적
// ──────────────────────────────────────────────

model MessageDelivery {
  id          String    @id @default(cuid())
  messageId   String    // MessageDraft.id 참조
  provider    String    @default("kakao_alimtalk") // kakao_alimtalk, sms, mock
  status      String    @default("queued") // queued, sending, sent, failed, cancelled
  sentAt      DateTime?
  failReason  String?
  retryCount  Int       @default(0)
  externalId  String?   // 카카오/SMS API 발송 ID
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  message MessageDraft @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([status])
  @@index([createdAt])
}

// ──────────────────────────────────────────────
// CTA 광고 캠페인 + 유입 귀속 추적
// ──────────────────────────────────────────────

model Campaign {
  id          String    @id @default(cuid())
  name        String    // 캠페인명: "2026년 3월 네이버 임플란트"
  platform    String    // naver, google, kakao, instagram, etc.
  adType      String    @default("cta") // cta, display, search
  startDate   DateTime
  endDate     DateTime?
  budgetWon   Int?      // 월 예산 (원)
  costPerClick Int?     // CPC 단가 (원)
  status      String    @default("active") // active, paused, ended
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  visits           Visit[]
  leadAttributions LeadAttribution[]

  @@index([platform])
  @@index([status])
}

model LeadAttribution {
  id           String    @id @default(cuid())
  visitId      String    @unique
  campaignId   String
  // 반자동 검토 워크플로우
  reviewStatus String    @default("pending") // pending, confirmed, rejected
  autoReason   String?   // 자동 분류 근거 텍스트
  confidence   Float?    // 자동 분류 신뢰도 (0.0~1.0)
  reviewer     String?   // 검토자 (향후 인증 연동)
  reviewedAt   DateTime?
  reviewMemo   String?   // 검토 메모
  // 정산 인정 조건 필드
  treatmentStarted Boolean @default(false) // 실제 진료 시작 여부 (상담만은 불인정)
  isDuplicate      Boolean @default(false) // 같은 환자 중복 유입 여부
  settlementMonth  String? // 정산 대상 월 (YYYY-MM 형식)
  settlementEligible Boolean @default(false) // 최종 정산 대상 여부
  ineligibleReason String? // 정산 미인정 사유
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  visit    Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([reviewStatus])
  @@index([settlementMonth])
  @@index([createdAt])
}

// ──────────────────────────────────────────────
// 감사 로그 (보안/접근 기록)
// 민감정보 포함 금지 - entityType + entityId로만 참조
// ──────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // view_pii, update_status, generate_message, review_attribution, export_data
  entityType String   // patient, visit, campaign, attribution
  entityId   String
  userId     String?  // 향후 인증 연동 시 사용자 ID
  detail     String?  // JSON 메타데이터 (PII 포함 금지)
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ──────────────────────────────────────────────
// 업무 처리 흐름 (Workflow)
// ──────────────────────────────────────────────

// 담당자 (병원 직원 + 내부 운영자 공통 모델)
model Staff {
  id        String   @id @default(cuid())
  tenantId  String?  // 멀티테넌시: null = 레거시/내부 운영자
  name      String   // 표시명: "데스크 김OO", "상담실장 박OO"
  role      String   @default("desk") // desk, counselor, doctor, manager
  staffType String   @default("clinic") // clinic: 병원 직원, operator: 내부 운영자
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant?        @relation(fields: [tenantId], references: [id])
  tasks      WorkflowTask[]
  activities ActivityLog[]

  @@index([tenantId])
  @@index([role])
  @@index([staffType])
  @@index([isActive])
}

// 환자별 업무 액션 아이템
model WorkflowTask {
  id            String    @id @default(cuid())
  patientId     String
  // 액션 유형: CTA_REVIEW, RECALL, CHURN_REENGAGE, MESSAGE_REVIEW, PERIO_RECALL, IMPLANT_FOLLOWUP, GENERAL
  actionType    String
  // 처리 상태: unprocessed, reviewing, waiting_contact, on_hold, excluded, completed, recheck_scheduled
  status        String    @default("unprocessed")
  assigneeId    String?   // 담당자 (Staff.id)
  note          String?   // 최신 처리 메모
  reason        String?   // 보류/제외/완료 사유
  nextFollowUpAt DateTime? // 다음 확인일
  completedAt   DateTime? // 완료 처리 시각
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patient    Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  assignee   Staff?        @relation(fields: [assigneeId], references: [id])
  activities ActivityLog[]

  @@index([patientId])
  @@index([status])
  @@index([actionType])
  @@index([assigneeId])
  @@index([nextFollowUpAt])
  @@index([createdAt])
}

// 변경 이력 (감사 로그 경량 버전)
model ActivityLog {
  id          String   @id @default(cuid())
  taskId      String?  // WorkflowTask.id
  patientId   String?  // 환자 직접 참조 (task 없이도 기록 가능)
  staffId     String?  // 변경한 담당자
  action      String   // status_change, assignee_change, note_added, followup_set, task_created
  fromValue   String?  // 이전 값
  toValue     String?  // 변경 후 값
  detail      String?  // JSON 메타데이터
  createdAt   DateTime @default(now())

  task    WorkflowTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  patient Patient?      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  staff   Staff?        @relation(fields: [staffId], references: [id])

  @@index([taskId])
  @@index([patientId])
  @@index([createdAt])
}

// ──────────────────────────────────────────────
// 대시보드 집계 Read Model
// 홈 대시보드에 표시할 사전 계산된 통계 + 우선순위 환자 목록
// 규칙 엔진 재실행 없이 단일 행 읽기로 즉시 렌더링
// ──────────────────────────────────────────────

model DashboardSummary {
  id        String   @id @default("singleton")
  statsJson String   // JSON: { todayActionCount, treatmentDropoutCount, recallDueCount, messageSuggestionCount }
  patientsJson String // JSON: PriorityPatientItem[] (top 25)
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ──────────────────────────────────────────────
// 유입 경로 규칙 (Source Rule Dictionary)
// ──────────────────────────────────────────────

model SourceRule {
  id               String   @id @default(cuid())
  ruleName         String   @unique // 규칙 식별자: instagram_ads, naver_search_ads, referral
  keywords         String   // JSON 배열: ["인스타", "인스타그램", "insta"]
  normalizedSource String   // 표준 소스명: "Instagram", "Naver Search Ads"
  sourceCategory   String   // 카테고리: "SNS", "Search Ads", "Referral", "Organic", "Offline", "Unknown"
  ctaCandidate     Boolean  @default(false) // CTA 후보 기본값
  priority         Int      @default(100) // 우선순위 (낮을수록 먼저 매칭)
  isActive         Boolean  @default(true)
  description      String?  // 규칙 설명
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  matchedVisits Visit[]

  @@index([isActive])
  @@index([priority])
}

// ──────────────────────────────────────────────
// 규칙 설정
// ──────────────────────────────────────────────

model RuleConfig {
  id          String   @id @default(cuid())
  tenantId    String?  // 멀티테넌시: null = 전역 기본값
  ruleType    String   @unique
  displayName String
  description String
  enabled     Boolean  @default(true)
  parameters  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// ──────────────────────────────────────────────
// 제품 영역 열거형
// ──────────────────────────────────────────────

enum ProductArea {
  hospital // 병원 SaaS (재내원 유도, 후속관리, 메시지)
  internal // 회사 내부용 (CPA 운영, 유입 경로 관리)
  all      // 양쪽 모두 (관리자 전용)
}

// ──────────────────────────────────────────────
// 사용자 / 인증
// ──────────────────────────────────────────────

model User {
  id             String      @id @default(cuid())
  tenantId       String?     // 멀티테넌시: null = 슈퍼어드민/레거시
  username       String      @unique
  passwordHash   String
  name           String
  role           String      @default("DESK") // ADMIN, DESK, COUNSELOR, VIEWER, MARKETING
  productArea    ProductArea @default(hospital)
  sessionVersion Int         @default(1) // 관리자 변경 시 증가 → 기존 세션 무효화
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([role])
  @@index([isActive])
  @@index([productArea])
}

// ──────────────────────────────────────────────
// 테넌트 (향후 멀티테넌트 분리 대비)
// 현재는 스키마만 정의 — 실제 데이터 격리는 P2에서 적용
// ──────────────────────────────────────────────

model Tenant {
  id          String      @id @default(cuid())
  name        String      // "OO치과", "CareFlow 본사"
  slug        String      @unique // URL-safe 식별자
  productArea ProductArea @default(hospital)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  users       User[]
  patients    Patient[]
  staff       Staff[]
  ruleConfigs RuleConfig[]

  @@index([slug])
  @@index([isActive])
}

// ──────────────────────────────────────────────
// 동기화 작업 (Sync Job)
// 모든 데이터 유입을 추적하는 상위 개념
// CSV Import, EMR Pull, Seed 등 모든 데이터 유입 이벤트
// ──────────────────────────────────────────────

model SyncJob {
  id               String    @id @default(cuid())
  syncType         String    // CSV_IMPORT, EMR_PULL, MANUAL_REPROCESS, SEED
  sourceSystem     String    // csv, mock-emr, api, seed
  status           String    @default("PENDING") // PENDING, RUNNING, SUCCESS, PARTIAL_SUCCESS, FAILED
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  totalRecords     Int       @default(0)
  successCount     Int       @default(0)
  failedCount      Int       @default(0)
  skippedCount     Int       @default(0)
  duplicateCount   Int       @default(0)
  unclassifiedCount Int      @default(0)
  errorSummary     String?
  triggeredBy      String    // 실행자 이름 (User.name 또는 "system")
  notes            String?
  importBatchId    String?   // ImportBatch 연결 (CSV_IMPORT인 경우)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([syncType])
  @@index([status])
  @@index([startedAt])
  @@index([createdAt])
}

// ──────────────────────────────────────────────
// CSV Import 배치 추적
// ──────────────────────────────────────────────

model ImportBatch {
  id              String   @id @default(cuid())
  fileName        String   // 업로드 파일명
  totalRows       Int      // CSV 전체 행 수
  successCount    Int      @default(0)
  failCount       Int      @default(0)
  unclassifiedCount Int    @default(0) // 미분류 건수
  reviewNeededCount Int    @default(0) // 검토 필요 건수
  status          String   @default("processing") // processing, completed, failed
  errorDetail     String?  // 실패 시 에러 메시지
  importedBy      String   @default("운영자") // 향후 인증 연동
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ──────────────────────────────────────────────
// 방문경로 정규화 변경 이력
// 분류 결과가 정산 근거에 영향을 줄 수 있으므로 이력 추적 필수
// ──────────────────────────────────────────────

model SourceNormalizationHistory {
  id              String   @id @default(cuid())
  visitId         String   // 대상 Visit.id
  batchKey        String?  // 묶음 처리 시 그룹 키 (sourceRaw 값 등)
  // 이전 값
  prevNormalizedSource  String?
  prevCategory          String?
  prevCtaCandidate      Boolean?
  prevReviewStatus      String?
  // 변경 후 값
  newNormalizedSource   String?
  newCategory           String?
  newCtaCandidate       Boolean?
  newReviewStatus       String?
  // 변경 메타
  changeType      String   // individual_review, batch_confirm, batch_reject, batch_modify, csv_import, auto_normalize
  changedBy       String   @default("운영자")
  changeMemo      String?  // 변경 사유
  createdAt       DateTime @default(now())

  @@index([visitId])
  @@index([batchKey])
  @@index([changeType])
  @@index([createdAt])
}

// ──────────────────────────────────────────────
// 발송 메시지 (운영 전체 라이프사이클)
// 초안 → 검토 → 승인 → 발송 → 성공/실패/재시도
// ──────────────────────────────────────────────

model OutboundMessage {
  id              String    @id @default(cuid())
  patientId       String
  // 컨텍스트
  messageType     String    // RECALL, CTA_FOLLOWUP, TREATMENT_RESUME, COUNSELING_FOLLOWUP, SCALING_REMINDER, GENERAL
  relatedTaskId   String?   // WorkflowTask 참조
  channel         String    @default("KAKAO") // KAKAO, SMS
  // 콘텐츠
  templateType    String?   // 사용된 템플릿 식별자
  draftMessage    String    // AI/템플릿 초안
  finalMessage    String?   // 최종 승인 메시지 (수정 가능)
  // 승인 흐름
  approvalStatus  String    @default("DRAFT") // DRAFT, REVIEW_NEEDED, APPROVED, REJECTED
  approvalMemo    String?
  approvedBy      String?
  approvedAt      DateTime?
  rejectedReason  String?
  // 발송 흐름
  sendStatus      String    @default("PENDING") // PENDING, SCHEDULED, SENDING, SENT, FAILED, RETRY_NEEDED, CANCELLED, BLOCKED
  scheduledAt     DateTime?
  sentAt          DateTime?
  failedAt        DateTime?
  failureReason   String?
  sendAttemptCount Int      @default(0)
  externalId      String?   // provider 발송 ID
  provider        String?   // 발송 provider (mock, kakao_alimtalk)
  // 안전장치
  duplicateBlocked    Boolean @default(false)
  duplicateReason     String?
  doNotContactBlocked Boolean @default(false)
  // 감사
  createdBy       String
  sentBy          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([approvalStatus])
  @@index([sendStatus])
  @@index([messageType])
  @@index([scheduledAt])
  @@index([createdAt])
}
