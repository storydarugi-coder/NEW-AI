# ============================================================
# CareFlow AI 환경변수 설정
# ============================================================
# 이 파일을 .env 로 복사하여 사용하세요:
#   cp .env.example .env

# ---- 데이터베이스 (Supabase PostgreSQL) ----
# Pooler 연결 (런타임 쿼리용 — serverless 호환)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct 연결 (마이그레이션/db push 전용)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ---- 인증 ----
# 프로덕션에서는 반드시 강력한 랜덤 키로 변경하세요
AUTH_SECRET="your-secret-key-change-in-production"

# ---- AI 메시지 생성 (선택) ----
# LLM 없이도 모든 기능이 정상 작동합니다 (템플릿 기반 fallback)
ENABLE_LLM_MESSAGE_GENERATION=false

# Google AI Studio (Gemini API) — ENABLE_LLM_MESSAGE_GENERATION=true 시 필요
# https://aistudio.google.com/apikey 에서 API Key를 발급받으세요
# GEMINI_API_KEY=your-api-key
# GEMINI_MODEL=gemini-3.1-pro-preview

# ---- 메시지 발송 ----
# MESSAGE_PROVIDER=mock    # 개발용 (기본값)
# MESSAGE_PROVIDER=kakao   # 카카오 알림톡 연동 시
# KAKAO_API_KEY=...
# KAKAO_SENDER_KEY=...
